{
  "name": "@trilha/api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "tsc && concurrently -k \"tsc --watch --preserveWatchOutput\" \"node --watch dist/index.js\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "echo \"sem testes ainda (T1.2)\" && exit 0"
  },
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "4.17.25",
    "@types/node": "26.6.6",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "prettier": "3.10.1",
    "typescript": "5.9",
    "typescript-eslint": "8.73.0"
  },
  "dependencies": {
    "body-parser": "1.20.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "express": "4.22.3",
    "reflect-metadata": "0.2.2",
    "routing-controllers": "0.11.3"
  }
}
